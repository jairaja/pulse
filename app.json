{
  "expo": {
    "name": "PULSE",
    "slug": "pulse",
    "scheme": "pulse",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#E9EAE6",
    "ios": {
      "bundleIdentifier": "com.pulse.worldtoday",
      "config": {
        "usesNonExemptEncryption": false
      },
      "supportsTablet": true
    },
    "android": {
      "package": "com.pulse.worldtoday"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ]
  }
}
