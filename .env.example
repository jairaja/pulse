EXPO_PUBLIC_TURNSTILE_CHALLENGE_URL=https://your-project-ref.supabase.co/functions/v1/turnstile-challenge
# Server-only: set DEVICE_FINGERPRINT_PEPPER with `supabase secrets set`; never prefix it EXPO_PUBLIC_.
