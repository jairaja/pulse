{
  "name": "pulse-app",
  "version": "0.3.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "npm run verify:step1 && expo start",
    "android": "npm run verify:step1 && expo start --android",
    "ios": "npm run verify:step1 && expo start --ios",
    "web": "npm run verify:step1 && expo start --web",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "doctor": "expo-doctor",
    "verify:step1": "node scripts/verify-step1.mjs",
    "verify:typecheck-scope": "node scripts/verify-typecheck-scope.mjs"
  },
  "dependencies": {
    "@react-navigation/drawer": "^7.14.3",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "typescript": "~5.9.0"
  }
}
