{
  "name": "pulse-app",
  "version": "0.3.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run verify:step1 && expo start",
    "android": "npm run verify:step1 && expo start --android",
    "db:baseline:clean": "node scripts/clean-legacy-migrations.mjs",
    "ios": "npm run verify:step1 && expo start --ios",
    "issues:create": "node scripts/create-github-issues.mjs",
    "issues:preview": "node scripts/create-github-issues.mjs",
    "lint": "expo lint",
    "web": "npm run verify:step1 && expo start --web",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "doctor": "expo-doctor",
    "verify:dependencies": "expo install --check",
    "verify:client-config": "node scripts/verify-client-config.mjs",
    "verify:database": "node scripts/verify-database-baseline.mjs",
    "verify:step1": "node scripts/verify-step1.mjs",
    "verify:typecheck-scope": "node scripts/verify-typecheck-scope.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.14",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
